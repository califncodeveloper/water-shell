rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product catalog images
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default lockdown: deny all other access until specific upload paths are defined
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
